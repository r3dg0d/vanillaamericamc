# Documentation only. The NixOS deployment uses root-owned files, not this file.
VA_DATABASE=/var/lib/vanilla-america-plus/integration/va-plus.db
VA_BIND=127.0.0.1:18080
VA_SERVER_ADDRESS=127.0.0.1:25565
VA_SERVER_LOG=/var/lib/vanilla-america-plus/server/logs/latest.log
VA_BOOTSTRAP_PASSWORD_FILE=/var/lib/vanilla-america-plus/credentials/portal-admin-password
VA_RCON_PASSWORD_FILE=/var/lib/vanilla-america-plus/credentials/rcon-password
VA_SYSTEMCTL=/run/current-system/sw/bin/systemctl
VA_SERVICE_NAME=vanilla-america-plus.service
